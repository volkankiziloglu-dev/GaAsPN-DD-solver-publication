/data/external/*
!/data/external/README.md

# MATLAB
*.asv
*.autosave
*.m~
*.mex*
slprj/
*.slxc
octave-workspace

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

